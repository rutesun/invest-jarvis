{
  "permissions": {
    "allow": [
      "Read",
      "Bash(tree:*)",
      "Bash(git diff*)",
      "mcp__serena__read_file",
      "mcp__serena__list_dir",
      "mcp__serena__find_file",
      "mcp__serena__search_for_pattern",
      "mcp__serena__get_symbols_overview",
      "mcp__serena__find_symbol",
      "mcp__serena__find_referencing_symbols",
      "mcp__serena__activate_project",
      "mcp__serena__get_current_config",
      "mcp__serena__initial_instructions",
      "mcp__serena__check_onboarding_performed"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-docs.sh",
            "timeout": 15,
            "statusMessage": "Checking documentation..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r 'if .tool_input.command | startswith(\"pip \") then {hookSpecificOutput: {hookEventName: \"PreToolUse\", permissionDecision: \"deny\", permissionDecisionReason: \"Use uv instead of pip.\\n\\nExamples:\\n  pip install package → uv add package\\n  pip install -e . → uv sync\\n  pip list → uv pip list\\n  pip freeze → uv pip freeze\"}} else {continue: true} end'"
          }
        ]
      }
    ]
  }
}
